 "sents": [
  {
   "p": 0,
   "t": "Ik wilde mijn nieuwe collega Lotte en haar vriend bij ons thuis uitnodigen.",
   "s": 6.26
  },
  {
   "p": 0,
   "t": "In Iran is het heel gewoon om iemand spontaan te bellen: “Kom vanavond eten!”",
   "s": 12.44
  },
  {
   "p": 0,
   "t": "Er is altijd genoeg, en hoe meer gasten, hoe beter.",
   "s": 19.18
  },
  {
   "p": 1,
   "t": "Dus vroeg ik in de pauze: “Hebben jullie zin om zaterdag bij ons te komen eten?”",
   "s": 24.79
  },
  {
   "p": 2,
   "t": "Lotte pakte haar telefoon.",
   "s": 31.73
  },
  {
   "p": 2,
   "t": "“Leuk!",
   "s": 34.82
  },
  {
