 "sents": [
  {
   "p": 0,
   "t": "In de derde week van juli is Nijmegen vier dagen lang één groot feest.",
   "s": 6.04
  },
  {
   "p": 0,
   "t": "Dan is er de Vierdaagse, de grootste wandeltocht ter wereld.",
   "s": 12.46
  },
  {
   "p": 0,
   "t": "Tienduizenden mensen lopen vier dagen achter elkaar dertig, veertig of vijftig kilometer per dag.",
   "s": 18.07
  },
  {
   "p": 1,
   "t": "Dani deed dit jaar voor het eerst mee.",
   "s": 26.43
  },
  {
   "p": 1,
   "t": "Hij had maandenlang getraind, elk weekend met een zware rugzak langs de Amstel.",
   "s": 30.19
  },
  {
   "p": 1,
   "t": "Hij koos voor vijftig kilometer per dag.",
   "s": 37.21
  },
  {
   "p": 2,
   "t": "Op vrijdag, de laatste dag, gingen Emma, Noah en wij met de trein naar Nijmegen.",
   "s": 41.33
  },
  {
   "p": 2,
   "t": "De stad zat vol muziek, vlaggen en mensen die aan de kant stonden te klappen.",
   "s": 49.33
  },
  {
   "p": 2,
   "t": "Overal werden gladiolen verkocht, lange bloemen in alle kleuren.",
   "s": 55.85
  },
  {
   "p": 2,
   "t": "“Die geef je aan de lopers als ze binnenkomen,” legde Emma uit.",
   "s": 62.01
  },
  {
   "p": 2,
   "t": "“Dat is een oude traditie.”",
   "s": 67.68
  },
  {
   "p": 3,
   "t": "Om drie uur zagen we Dani eindelijk.",
   "s": 70.66
  },
  {
   "p": 3,
   "t": "Hij liep een beetje mank en zijn gezicht was rood van de zon, maar hij straalde.",
   "s": 74.57
  },
  {
   "p": 3,
   "t": "Emma rende naar hem toe met een bos gladiolen.",
   "s": 81.13
  },
  {
   "p": 4,
   "t": "“Hoe voel je je?” vroeg ik.",
   "s": 85.46
  },
  {
   "p": 5,
   "t": "“Mijn voeten zijn kapot,” lachte hij.",
   "s": 89.66
  },
  {
   "p": 5,
   "t": "“Ik heb zes blaren.",
   "s": 93.68
  },
  {
   "p": 5,
   "t": "Maar ik heb het gehaald!”",
   "s": 96.26
  },
  {
   "p": 5,
   "t": "Trots liet hij zijn Vierdaagsekruis zien, de medaille die je krijgt als je alle vier de dagen hebt uitgelopen.",
   "s": 98.93
  },
  {
   "p": 6,
   "t": "“Volgend jaar loop jij mee,” zei hij tegen mij.",
   "s": 107.69
  },
  {
   "p": 6,
   "t": "Ik weet nog niet of dat een goed idee is.",
   "s": 112.35
  }
 ],
