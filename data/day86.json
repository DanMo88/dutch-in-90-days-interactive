 "sents": [
  {
   "p": 0,
   "t": "Op een vrijdagavond aten Dani en Emma bij ons.",
   "s": 5.18
  },
  {
   "p": 0,
   "t": "We hadden het over mijn collega Mark.",
   "s": 9.92
  },
  {
   "p": 0,
   "t": "Hij had een prijs gewonnen voor het beste verbeteridee van het ziekenhuis, maar hij had het niemand verteld.",
   "s": 13.78
  },
  {
   "p": 0,
   "t": "Ik las het toevallig in de nieuwsbrief.",
   "s": 21.04
  },
  {
   "p": 0,
   "t": "“Typisch Nederlands,” zei Emma.",
   "s": 24.57
  },
  {
   "p": 0,
   "t": "“Je gaat niet opscheppen.",
   "s": 28.1
  },
  {
   "p": 0,
   "t": "Doe maar normaal, dan doe je al gek genoeg.”",
   "s": 30.85
  },
  {
   "p": 0,
   "t": "“En wie opvalt met een dure auto, is al gauw een patser,” vulde Dani aan.",
   "s": 35.01
  },
  {
   "p": 1,
   "t": "Ik moest lachen.",
   "s": 41.23
  },
  {
   "p": 1,
   "t": "In Iran is het juist beleefd om elkaar te prijzen.",
   "s": 43.62
  },
  {
   "p": 1,
   "t": "We hebben zelfs een woord voor onze beleefdheid: taarof.",
   "s": 48.13
  },
  {
   "p": 1,
   "t": "Je biedt iets drie keer aan, en de ander weigert twee keer, ook als hij het graag wil.",
   "s": 53.09
  },
  {
   "p": 2,
   "t": "“Dat werkt hier niet,” zei Emma.",
   "s": 59.29
  },
  {
   "p": 2,
   "t": "“Als een Nederlander nee zegt, bedoelt hij nee.",
   "s": 62.79
  },
  {
   "p": 2,
   "t": "Dan krijgt hij niets.”",
   "s": 67.21
  },
  {
   "p": 2,
   "t": "“Dat heb ik gemerkt,” zei ik.",
   "s": 69.99
  },
  {
   "p": 2,
   "t": "“In mijn eerste maanden heb ik heel wat koekjes misgelopen.”",
   "s": 73.54
  },
  {
   "p": 3,
   "t": "Iedereen lachte.",
   "s": 78.37
  },
  {
   "p": 3,
   "t": "Toen werd Dani even serieus.",
   "s": 80.68
  },
  {
   "p": 3,
   "t": "“Maar die bescheidenheid heeft ook een nadeel.",
   "s": 84.13
  },
  {
   "p": 3,
   "t": "Soms durven we niet te zeggen dat we trots zijn.”",
   "s": 88.29
  },
  {
   "p": 3,
   "t": "“Nou, ik ben trots op jou,” zei Alex tegen mij.",
   "s": 92.42
  },
  {
   "p": 3,
   "t": "“Je Nederlands is enorm vooruitgegaan.”",
   "s": 97.35
  },
  {
   "p": 4,
   "t": "Ik keek naar mijn bord.",
   "s": 101.45
  },
  {
   "p": 4,
   "t": "“Ach, het valt wel mee.”",
   "s": 104.18
  },
  {
   "p": 4,
   "t": "Even was het stil.",
   "s": 107.37
  },
  {
   "p": 4,
   "t": "Toen barstte Dani in lachen uit.",
   "s": 109.88
  },
  {
   "p": 4,
   "t": "“Zie je?",
   "s": 113.42
  },
  {
   "p": 4,
   "t": "Nu ben je echt een van ons.”",
   "s": 115.24
  }
 ],
