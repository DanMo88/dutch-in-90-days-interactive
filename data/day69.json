  },
  {
   "p": 2,
   "t": "Volgende week ook niet.",
   "s": 44.58
  },
  {
   "p": 2,
   "t": "Over drie weken, op vrijdag?",
   "s": 47.41
  },
  {
   "p": 2,
   "t": "Dan heb ik nog een gaatje.”",
   "s": 51.19
  },
  {
   "p": 3,
   "t": "Drie weken!",
   "s": 53.98
  },
  {
   "p": 3,
   "t": "Ik moest erom lachen, maar Lotte meende het.",
   "s": 56.23
  },
  {
   "p": 3,
   "t": "Ze stuurde me zelfs een Datumprikker: een linkje waarop je kunt aanklikken welke dagen je kunt.",
   "s": 60.32
  },
  {
   "p": 4,
   "t": "“Heel normaal,” zei Dani later.",
   "s": 67.77
  },
  {
   "p": 4,
   "t": "“Nederlanders plannen alles, ook met vrienden.",
   "s": 71.54
  },
  {
   "p": 4,
   "t": "Als je iemand onverwacht uitnodigt, vinden mensen dat lief, maar vaak kunnen ze niet.",
   "s": 76.05
  },
  {
   "p": 4,
   "t": "En nog een tip: we eten vroeg, rond zes uur.",
   "s": 83.54
  },
  {
   "p": 4,
   "t": "Als je om acht uur pas begint, hebben je gasten al gegeten.”",
   "s": 88.71
  },
  {
   "p": 5,
   "t": "Drie weken later stonden Lotte en haar vriend precies om zes uur voor de deur, met een bos bloemen.",
   "s": 94.4
  },
  {
   "p": 5,
   "t": "Ik had Perzische rijst met saffraan gemaakt, met kip en een salade.",
   "s": 102.44
  },
  {
   "p": 5,
   "t": "Ze bleven tot middernacht.",
   "s": 108.55
  },
  {
   "p": 6,
   "t": "Bij de deur pakte Lotte haar telefoon.",
   "s": 111.62
  },
  {
   "p": 6,
   "t": "“Volgende keer bij ons.",
   "s": 115.46
  },
  {
   "p": 6,
   "t": "Wanneer kunnen jullie?”",
   "s": 118.41
