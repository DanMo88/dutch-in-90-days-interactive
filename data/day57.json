 "sents": [
  {
   "p": 0,
   "t": "In juni komt de nieuwe haring.",
   "s": 5.27
  },
  {
   "p": 0,
   "t": "In Scheveningen, bij Den Haag, is er dan een groot feest: Vlaggetjesdag.",
   "s": 8.58
  },
  {
   "p": 0,
   "t": "De vissersboten in de haven hebben honderden vlaggetjes.",
   "s": 15.76
  },
  {
   "p": 1,
   "t": "Op zaterdag namen we de trein naar Den Haag en daarna de tram naar zee.",
   "s": 20.88
  },
  {
   "p": 2,
   "t": "De haven was vol mensen.",
   "s": 26.93
  },
  {
   "p": 2,
   "t": "Overal waren oude schepen en kraampjes.",
   "s": 30.19
  },
  {
   "p": 3,
   "t": "Bij een viskraam bestelde Dani drie Hollandse Nieuwe.",
   "s": 34.44
  },
  {
   "p": 3,
   "t": "“Dat is de eerste haring van het jaar,” legde hij uit.",
   "s": 39.43
  },
  {
   "p": 3,
   "t": "“Hij is zacht en een beetje zout.”",
   "s": 44.63
  },
  {
   "p": 3,
   "t": "De visboer legde er uitjes op.",
   "s": 48.04
  },
  {
   "p": 4,
   "t": "“Kijk, zo doe je het,” zei Dani.",
   "s": 51.69
  },
  {
   "p": 4,
   "t": "Hij pakte de haring bij de staart, hield zijn hoofd achterover en liet de vis in zijn mond zakken.",
   "s": 55.65
  },
  {
   "p": 4,
   "t": "In twee happen was hij op.",
   "s": 63.63
  },
  {
   "p": 5,
   "t": "Alex deed het hem na.",
   "s": 66.77
  },
  {
   "p": 5,
   "t": "“Hm... lekker!”",
   "s": 69.58
  },
  {
   "p": 5,
   "t": "Ik was eerst een beetje bang, maar ik probeerde het toch.",
   "s": 72.96
  },
  {
   "p": 5,
   "t": "Het smaakte fris en zacht, helemaal niet vies.",
   "s": 77.87
  },
  {
   "p": 6,
   "t": "Mia wilde geen rauwe vis.",
   "s": 82.65
  },
  {
   "p": 6,
   "t": "Zij kreeg kibbeling: gebakken stukjes vis met saus.",
   "s": 85.91
  },
  {
   "p": 6,
   "t": "“Dit is veel lekkerder,” zei ze met volle mond.",
   "s": 91.05
  }
 ],
