 "sents": [
  {
   "p": 0,
   "t": "Op 4 mei herdenkt Nederland alle mensen die zijn gestorven in oorlogen, vooral in de Tweede Wereldoorlog.",
   "s": 2.71
  },
  {
   "p": 0,
   "t": "Het heet de Dodenherdenking.",
   "s": 14.76
  },
  {
   "p": 0,
   "t": "Dan hangen de vlaggen halfstok.",
   "s": 18.17
  },
  {
   "p": 1,
   "t": "Oma Anna kwam die avond bij ons eten.",
   "s": 21.6
  },
  {
   "p": 2,
   "t": "Na het eten vertelde ze over haar vader.",
   "s": 25.81
  },
  {
   "p": 2,
   "t": "“Hij was twaalf jaar toen de oorlog begon.",
   "s": 30.01
  },
  {
   "p": 2,
   "t": "In de laatste winter was er bijna geen eten in Amsterdam.",
   "s": 33.87
  },
  {
   "p": 2,
   "t": "Dat noemen we de Hongerwinter.",
   "s": 38.81
  },
  {
   "p": 2,
   "t": "Soms aten ze zelfs tulpenbollen.”",
   "s": 41.81
  },
  {
   "p": 3,
   "t": "“Tulpenbollen?” vroeg Mia met grote ogen.",
