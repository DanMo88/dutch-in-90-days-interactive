  {
   "p": 0,
   "t": "Een week voor kerst stond er op de afdeling een grote doos met mijn naam erop: mijn kerstpakket.",
   "s": 6.02
  },
  {
   "p": 0,
   "t": "Veel Nederlandse werkgevers geven hun personeel aan het eind van het jaar zo'n pakket, als bedankje.",
   "s": 13.88
  },
  {
   "p": 0,
   "t": "In het mijne zaten wijn, kaas, chocolade, een theedoek en een cadeaubon.",
   "s": 21.88
  },
  {
   "p": 1,
   "t": "Dit jaar wilde ik zelf het kerstdiner koken.",
   "s": 29.23
  },
  {
   "p": 1,
   "t": "Op tweede kerstdag nodigden we Dani, Emma, Noah en Oma Anna uit in ons nieuwe huis.",
   "s": 33.52
  },
  {
   "p": 1,
   "t": "Vorig jaar hadden zij ons verwend met gourmetten.",
