 "sents": [
  {
   "p": 0,
   "t": "Het is eenendertig december: oudejaarsavond.",
   "s": 4.94
  },
  {
   "p": 0,
   "t": "We vieren het bij Dani en Emma.",
   "s": 9.91
  },
  {
   "p": 0,
   "t": "Op tafel staat een schaal oliebollen van Oma Anna.",
   "s": 13.47
  },
  {
   "p": 1,
   "t": "Het is een bijzonder jaar.",
   "s": 18.43
  },
  {
   "p": 1,
   "t": "Mensen mogen zelf geen vuurwerk meer afsteken.",
   "s": 21.23
  },
  {
   "p": 1,
   "t": "Dat is nu verboden in heel Nederland.",
   "s": 25.98
  },
  {
   "p": 2,
   "t": "“Is dat niet saai?” vraagt Alex.",
   "s": 29.96
  },
  {
   "p": 3,
   "t": "“Nee hoor,” zegt Dani.",
   "s": 34.76
  },
  {
   "p": 3,
   "t": "“De gemeente geeft een grote vuurwerkshow boven het IJ.",
   "s": 37.91
  },
  {
   "p": 3,
   "t": "En sterretjes mogen nog wel.”",
   "s": 42.88
  },
  {
   "p": 4,
   "t": "Om half twaalf lopen we samen naar het water.",
   "s": 46.13
  },
  {
   "p": 4,
   "t": "Er zijn duizenden mensen.",
   "s": 50.43
  },
  {
   "p": 5,
   "t": "Dan tellen we samen af: “Tien, negen, acht... drie, twee, één!”",
   "s": 53.43
  },
  {
   "p": 6,
   "t": "“Gelukkig nieuwjaar!”",
   "s": 61.52
  },
  {
   "p": 7,
   "t": "Boven het IJ knalt het vuurwerk: rood, groen, goud en zilver.",
   "s": 64.04
  },
  {
   "p": 7,
   "t": "Het is prachtig.",
   "s": 70.9
  },
  {
   "p": 8,
   "t": "Mia zwaait met haar sterretje.",
   "s": 73.29
  },
  {
   "p": 8,
   "t": "Iedereen geeft elkaar drie zoenen: links, rechts, links.",
   "s": 76.55
  },
  {
   "p": 8,
   "t": "“Gelukkig nieuwjaar, Sara!” zegt Emma.",
   "s": 82.55
  },
  {
   "p": 8,
   "t": "“Jij ook, Emma!",
   "s": 88.08
  },
  {
   "p": 8,
   "t": "En de baby ook!”",
   "s": 90.83
  },
  {
   "p": 9,
   "t": "Alex pakt mijn hand.",
   "s": 93.41
  },
  {
   "p": 9,
   "t": "“Ons eerste nieuwjaar in Nederland.”",
   "s": 96.19
  }
 ],
