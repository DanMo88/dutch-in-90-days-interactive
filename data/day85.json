 "sents": [
  {
   "p": 0,
   "t": "Voor Dani wilde ik een surprise maken die bij hem paste: een fiets, natuurlijk.",
   "s": 4.94
  },
  {
   "p": 1,
   "t": "Drie avonden zat ik met Mia aan de keukentafel, tussen dozen, wc-rolletjes, lijm en verf.",
   "s": 11.8
  },
  {
   "p": 1,
   "t": "Van papieren bordjes maakten we wielen, van een oude doos het frame.",
   "s": 21.1
  },
  {
   "p": 1,
   "t": "Mia schilderde alles groen, de kleur van Dani's trui.",
   "s": 26.99
  },
  {
   "p": 1,
   "t": "Binnenin, in de 'fietstas', zaten zijn cadeautjes: wollen sokken, een fietsbel en een zak drop.",
   "s": 32.29
  },
  {
   "p": 2,
   "t": "Op 5 december, pakjesavond, zaten we met z'n allen bij Oma Anna.",
   "s": 41.46
  },
  {
   "p": 2,
   "t": "Overal brandden kaarsjes, er stond een schaal met pepernoten en chocoladeletters.",
   "s": 48.44
  },
  {
   "p": 3,
   "t": "Om de beurt kreeg iedereen zijn surprise.",
   "s": 55.85
  },
  {
   "p": 3,
   "t": "Eerst las je het gedicht hardop voor, pas daarna mocht je uitpakken.",
   "s": 59.83
  },
  {
   "p": 3,
   "t": "Alex kreeg van Emma een kartonnen laptop, met een gedicht over zijn eindeloze vergaderingen.",
   "s": 65.65
  },
  {
   "p": 4,
   "t": "Toen was Dani aan de beurt.",
   "s": 73.52
  },
  {
   "p": 4,
   "t": "Hij bekeek de groene fiets van alle kanten.",
   "s": 76.54
  },
  {
   "p": 4,
   "t": "“Prachtig!",
   "s": 80.63
  },
  {
   "p": 4,
   "t": "Wie heeft dit gemaakt?”",
   "s": 82.6
  },
  {
   "p": 5,
   "t": "Hij las mijn gedicht voor, en bij de regel over te laat komen lachte iedereen, Dani het hardst.",
   "s": 85.27
  },
  {
   "p": 5,
   "t": "“Sint heeft dit jaar wel heel goed Nederlands leren schrijven,” zei hij met een knipoog naar mij.",
   "s": 93.35
  },
  {
   "p": 6,
   "t": "Ik werd rood.",
   "s": 100.77
  },
  {
   "p": 6,
   "t": "Mia sprong op.",
   "s": 102.9
  },
  {
   "p": 6,
   "t": "“Het was mama!",
   "s": 105.47
  },
  {
   "p": 6,
   "t": "En ik heb geholpen!”",
   "s": 107.72
  },
  {
   "p": 6,
   "t": "Zo was het geheim alsnog verklapt.",
   "s": 110.32
  },
  {
   "p": 6,
   "t": "Maar niemand vond dat erg.",
   "s": 114.04
  }
 ],
