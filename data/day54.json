  },
  {
   "p": 4,
   "t": "“Ja, schat.",
   "s": 51.15
  },
  {
   "p": 4,
   "t": "Er was niets anders.”",
   "s": 53.79
  },
  {
   "p": 5,
   "t": "Om acht uur zetten we de televisie aan.",
   "s": 56.71
  },
  {
   "p": 5,
   "t": "Op de Dam stonden duizenden mensen bij het Nationaal Monument.",
   "s": 60.38
  },
  {
   "p": 5,
   "t": "De koning en de koningin legden een krans.",
   "s": 65.54
  },
  {
   "p": 5,
   "t": "Toen werd heel Nederland twee minuten stil.",
   "s": 69.56
  },
  {
   "p": 5,
   "t": "Op straat stopten zelfs de fietsers.",
   "s": 73.45
  },
  {
   "p": 6,
   "t": "Oma Anna hield de hand van Mia vast.",
