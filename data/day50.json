 "sents": [
  {
   "p": 0,
   "t": "Het was Pasen.",
   "s": 4.31
  },
  {
   "p": 0,
   "t": "Op eerste paasdag waren veel winkels dicht en hadden de meeste mensen vrij.",
   "s": 6.84
  },
  {
   "p": 1,
   "t": "'s Ochtends gingen we met Dani, Emma en Noah naar het Vondelpark.",
   "s": 12.81
  },
  {
   "p": 1,
   "t": "Daar was een paaseierenzoektocht voor kinderen.",
   "s": 18.45
  },
  {
   "p": 1,
   "t": "Onder de struiken en in het gras lagen gekleurde eieren verstopt.",
   "s": 22.68
  },
  {
   "p": 2,
   "t": "“Klaar?",
   "s": 28.2
  },
  {
   "p": 2,
   "t": "Af!” riep een vrouw met konijnenoren.",
   "s": 29.87
  },
  {
   "p": 3,
   "t": "Mia zocht heel goed.",
   "s": 34.88
  },
  {
   "p": 3,
   "t": "Ze vond een rood ei achter een bankje en een blauw ei in een bloempot.",
   "s": 37.85
  },
  {
   "p": 3,
   "t": "Achter een grote boom vond ze zelfs een gouden ei.",
   "s": 43.42
  },
  {
   "p": 3,
   "t": "“Mama!",
   "s": 47.88
  },
  {
   "p": 3,
   "t": "Ik heb de hoofdprijs!”",
   "s": 49.73
  },
  {
   "p": 3,
   "t": "Ze kreeg een grote paashaas van chocolade.",
   "s": 52.46
  },
  {
   "p": 4,
   "t": "Daarna gingen we naar het huis van Dani en Emma voor de paasbrunch.",
   "s": 56.9
  },
  {
   "p": 4,
   "t": "De tafel stond vol: eieren, croissants, kaas, fruit en paasbrood.",
   "s": 62.46
  },
  {
   "p": 4,
   "t": "Oma Anna kwam ook.",
   "s": 69.62
  },
  {
   "p": 4,
   "t": "Ze had gekleurde eieren meegenomen die ze zelf had beschilderd.",
   "s": 72.54
  },
  {
   "p": 5,
   "t": "“Bij ons doen we een spelletje,” zei Dani.",
   "s": 77.81
  },
  {
   "p": 5,
   "t": "“Eiertikken!",
   "s": 81.63
  },
  {
   "p": 5,
   "t": "Iedereen tikt met zijn ei tegen dat van een ander.",
   "s": 83.82
  },
  {
   "p": 5,
   "t": "Wie als laatste een heel ei heeft, wint.”",
   "s": 88.04
  },
  {
   "p": 6,
   "t": "Oma Anna won.",
   "s": 92.26
  },
  {
   "p": 6,
   "t": "“Ervaring,” zei ze met een knipoog.",
   "s": 94.84
  }
 ],
