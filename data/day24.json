  },
  {
   "p": 3,
   "t": "Mia maakt een tekening van het paard Ozosnel.",
   "s": 33.65
  },
  {
   "p": 3,
   "t": "Ze legt een wortel in haar schoen.",
   "s": 37.93
  },
  {
   "p": 3,
   "t": "“Voor het paard,” zegt ze.",
   "s": 41.27
  },
  {
