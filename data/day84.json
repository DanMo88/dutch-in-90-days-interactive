  {
   "p": 0,
   "t": "Wat rijmt er op Dani?",
   "s": 9.87
  },
  {
   "p": 1,
   "t": "Een Sinterklaasgedicht heeft een vaste vorm.",
   "s": 12.71
  },
  {
   "p": 1,
   "t": "Het is geschreven alsof Sinterklaas het zelf heeft gemaakt, en de regels rijmen twee aan twee.",
   "s": 16.84
  },
  {
   "p": 1,
   "t": "Je plaagt de ander met iets wat iedereen van hem weet.",
   "s": 24.31
  },
  {
   "p": 2,
   "t": "Over Dani weet iedereen twee dingen: hij zit altijd op zijn fiets, ook als het stormt, en hij komt altijd te laat, omdat hij onderweg met iedereen een praatje maakt.",
   "s": 28.56
  },
  {
   "p": 3,
   "t": "Ik schreef: “Sinterklaas zag Dani fietsen, door de regen en de wind. / Hij groet elke buurman, elke hond en elk kind.”",
   "s": 39.31
  },
  {
   "p": 4,
   "t": "Niet slecht!",
   "s": 50.57
  },
  {
   "p": 4,
   "t": "Maar daarna liep ik vast.",
   "s": 52.81
  },
  {
   "p": 4,
   "t": "Ik ging naar Emma, die het geheim natuurlijk niet zou verraden.",
   "s": 55.96
  },
  {
   "p": 5,
   "t": "“Rijm is niet het moeilijkste,” zei ze, terwijl Noah op haar knie zat.",
   "s": 60.87
  },
  {
   "p": 5,
   "t": "“Het ritme is belangrijk.",
   "s": 66.67
  },
  {
   "p": 5,
   "t": "Lees het hardop.”",
   "s": 69.85
  },
  {
   "p": 5,
   "t": "Ze tikte de maat op tafel, en al snel hoorde ik waar mijn zinnen te lang waren.",
   "s": 72.45
  },
  {
   "p": 6,
   "t": "Samen maakten we nog twee regels: “Hij komt altijd te laat, maar altijd met een lach, / want hij praat met de hele buurt, de hele dag.”",
   "s": 78.54
  },
  {
   "p": 7,
   "t": "Na een avond schrappen en herschrijven had ik twaalf regels.",
   "s": 88.32
  },
  {
   "p": 7,
   "t": "Ik las ze voor aan Alex.",
   "s": 93.49
  },
  {
   "p": 7,
   "t": "Hij lachte zo hard dat Mia uit bed kwam.",
   "s": 96.79
  }
