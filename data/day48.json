  },
  {
   "p": 0,
   "t": "“Wat hebben we fout gedaan?”",
   "s": 17.71
  },
  {
   "p": 1,
   "t": "We gingen meteen naar Dani.",
   "s": 20.63
  },
  {
   "p": 1,
   "t": "“Rustig maar!",
   "s": 23.7
  },
  {
   "p": 1,
   "t": "Veel mensen krijgen in het voorjaar zo'n brief.",
