  },
  {
   "p": 3,
   "t": "Dat is voor mensen die in dat jaar naar Nederland zijn gekomen.",
   "s": 51.56
  },
  {
   "p": 3,
   "t": "Je hebt tot 1 juli de tijd, in plaats van 1 mei.”",
   "s": 56.35
  },
  {
   "p": 4,
   "t": "Dani legde uit dat je kunt inloggen met DigiD.",
   "s": 61.26
  },
  {
   "p": 4,
   "t": "Veel gegevens staan er al in, zoals het salaris van Alex.",
   "s": 66.07
  },
  {
   "p": 4,
   "t": "“Controleer alles goed.”",
   "s": 71.71
  },
  {
