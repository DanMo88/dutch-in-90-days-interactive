  },
  {
   "p": 1,
   "t": "Dan vertel je hoeveel je vorig jaar hebt verdiend.”",
   "s": 33.63
  },
  {
   "p": 2,
   "t": "“Maar we wonen hier pas sinds september,” zei ik.",
   "s": 37.82
  },
  {
   "p": 3,
   "t": "“Precies.",
